# ──────────────────────────────────────────────────────────────
# Agent Platform — Environment Configuration
# Copy to .env and fill in values
# ──────────────────────────────────────────────────────────────

# ── Primary LLM (GPU — reasoning / generation) ───────────────
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
LLM_HARDWARE=XPU
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# ── Secondary LLM (CPU — classification / extraction) ────────
SECONDARY_LLM_BASE_URL=http://localhost:8001/v1
SECONDARY_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
SECONDARY_LLM_HARDWARE=Xeon
SECONDARY_LLM_MODULES=classify,extract_entities

# ── Retrieval ────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
VECTOR_INDEX_DIR=data/index
LEXICAL_INDEX_DIR=data/lexical
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=10
RETRIEVAL_TOP_N=50

# ── API ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8081
API_KEY=
CORS_ORIGINS=*

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///agent_platform.db

# ── Search providers (for Deep Research web search) ──────────
TAVILY_API_KEY=
SERPER_API_KEY=

# ── Security ─────────────────────────────────────────────────
REQUIRE_AUTH=false
JWT_SECRET=change-me-in-production
APPROVAL_TIMEOUT_S=300
PII_REDACTION_ENABLED=true

# ── Observability ────────────────────────────────────────────
LOG_LEVEL=INFO
METRICS_ENABLED=true
AUDIT_ENABLED=true

# ── Agent tuning ─────────────────────────────────────────────
AGENT_MAX_ITERATIONS=15
SUPERVISOR_MAX_ROUNDS=5
MAX_SUB_AGENTS=4
MAX_CONTEXT_TOKENS=8192
